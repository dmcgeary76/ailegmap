# Required: free key from https://legiscan.com/legiscan
LEGISCAN_API_KEY=your_key_here

# Optional. Defaults to a SQLite file at backend/k12_ai.db
# DATABASE_URL=sqlite:////absolute/path/to/k12_ai.db

# Only needed once, to pull data out of the pre-v0.2 Postgres database
# POSTGRES_URL=postgresql://k12_user:k12_password@localhost:5432/k12_ai_db
